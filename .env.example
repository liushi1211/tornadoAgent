# 复制为 .env 后填写（docker compose 会自动读取）
# 模型密钥（DashScope）
SAA_KEY_DASHSCOPE=sk-xxxxxxxxxxxxxxxx
# MySQL（默认走宿主机 5.7 cloud_ai 库）
DB_USER=root
DB_PASS=root
# JWT 签名密钥（≥32 字符随机串）
SAA_JWT_SECRET=change-me-to-a-long-random-string-0123456789
# 业务密钥加密主密钥（32 字节 base64）：openssl rand -base64 32
SAA_MASTER_KEY=change-me-base64-32-bytes-key==
# 前端镜像标签
TAG=latest
