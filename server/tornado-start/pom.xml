<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tornado</groupId>
        <artifactId>tornado-agent-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>tornado-start</artifactId>
    <name>tornado-start</name>
    <description>启动装配层：main、application.yml、Bean 装配、ArchUnit 架构守护测试（M6 接管可执行入口）</description>

    <dependencies>
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-adapter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 运行时数据源连接池（取代 Hikari，提供监控台/慢SQL/防火墙）；start 作为可执行装配模块聚合运行时依赖 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
        <!-- ArchUnit 架构守护测试 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>tornado-start</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
