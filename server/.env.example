# tornado-agent 后端环境变量示例（复制为 .env 并填写）
# AES-GCM 主密钥：32 字节 base64，用于 MCP headers 加密（缺省用内置 dev key 并告警）
SAA_MASTER_KEY=
# DashScope API Key（chat.models 与 embedding 共用）
SAA_KEY_DASHSCOPE=sk-xxxxxxxx
# OpenAI 兼容端点 Key（可选，openai-compatible 模型无显式 api-key 时读取）
SAA_OPENAI_API_KEY=
# MySQL
DB_URL=jdbc:mysql://localhost:3306/cloud_ai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USER=root
DB_PASS=root
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# JWT 签名密钥（>=32 字符）
SAA_JWT_SECRET=change-me-to-a-long-random-string-0123456789
# RAG 上传目录 / Nacos
RAG_UPLOAD_DIR=./data/rag-files
NACOS_ADDR=localhost:8848
