<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tornado</groupId>
        <artifactId>tornado-agent-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>tornado-app</artifactId>
    <name>tornado-app</name>
    <description>应用层：Command/Query 编排器、事务边界、领域事件订阅、xxl-job Handler、DTO 装配</description>

    <dependencies>
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- chat 运行时装配（务实：ChatModelFactory/AgentAssembler 直接依赖 Spring AI / DashScope） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>
        <!-- chat 运行时依赖基础设施实现（McpToolFactory / SaverRegistry / MemoryConfig） -->
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-infrastructure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SAA agent-framework(ReactAgent/HITL/拦截器) + graph-core(NodeOutput/RunnableConfig/InterruptionMetadata) -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>
        <!-- xxl-job 定时任务 Handler（会话摘要兜底 / HITL 过期） -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>
        <!-- 应用服务流水线日志（@Slf4j） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
