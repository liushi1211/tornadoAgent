<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tornado</groupId>
        <artifactId>tornado-agent-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>tornado-infrastructure</artifactId>
    <name>tornado-infrastructure</name>
    <description>基础设施层：Repository 实现(DO+Mapper)/Gateway 实现(Redis/Nacos/LLM/MCP/沙箱)/Crypto/序列化</description>

    <dependencies>
        <!-- McpToolFactory 产出 Spring AI ToolCallback -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>
        <!-- RAG 文档解析（pdfbox / poi XWPF） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <!-- RAG 向量库 RedisVectorStore + 自建 OpenAI 兼容 embedding -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tornado</groupId>
            <artifactId>tornado-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
